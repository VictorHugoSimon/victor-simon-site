DEPLOY_ENVIRONMENT=staging
WORKER_NAME=victor-simon-api-staging
D1_DATABASE_NAME=vhs-db-staging
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
R2_BUCKET_NAME=victor-simon-media-staging
CORS_ORIGIN=https://victor-simon-site-staging.pages.dev
API_BASE=https://victor-simon-api-staging.example.workers.dev
PAGES_PROJECT_NAME=victor-simon-site-staging
LINKEDIN_API_VERSION=202604
META_API_VERSION=v26.0

# Opcional: cron UTC do Growth Loop. Defaults: staging 11:47 UTC, production 11:17 UTC.
GROWTH_CRON=

# Secrets de entrada: configure no GitHub e nunca faça commit dos valores.
CLOUDFLARE_API_TOKEN=
ADMIN_PASSWORD=

# Opcional: o bootstrap descobre a conta automaticamente quando possível.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_NAME=

# OAuth social opcional. Configure pares completos para ativar cada canal.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
